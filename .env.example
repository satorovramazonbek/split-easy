# Copy to .env (never commit .env) or export these variables in your shell.

# Secret for signing JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SPLITEASY_SECRET_KEY=change-me

# SQLite file in the project folder by default.
SPLITEASY_DATABASE_URL=sqlite:///./spliteasy.db

# Access token lifetime in minutes.
SPLITEASY_ACCESS_TOKEN_MINUTES=60
